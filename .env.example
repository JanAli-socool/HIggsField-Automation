# Database
DATABASE_URL="postgresql://user:password@localhost:5432/higgsfield?schema=public"

# Redis (for queue)
REDIS_URL="redis://localhost:6379"

# Authentication
AUTH_SECRET="your-super-secret-auth-key-min-32-chars"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Storage (Vercel Blob / S3 / Cloudflare R2)
BLOB_READ_WRITE_TOKEN="vercel_blob_token_or_s3_credentials"
STORAGE_ENDPOINT="https://your-bucket.s3.region.amazonaws.com"
STORAGE_BUCKET="higgsfield-assets"
STORAGE_ACCESS_KEY="your-access-key"
STORAGE_SECRET_KEY="your-secret-key"
STORAGE_PUBLIC_URL="https://your-bucket.s3.region.amazonaws.com"

# Nemotron (for prompt enhancement)
NEMOTRON_API_KEY="your-nemotron-api-key"
NEMOTRON_BASE_URL="https://integrate.api.nvidia.com/v1"

# Image Generation Providers
FLUX_API_KEY="your-flux-api-key"
FLUX_BASE_URL="https://api.your-flux-provider.com"

SDXL_API_KEY="your-sdxl-api-key"
SDXL_BASE_URL="https://api.your-sdxl-provider.com"

QWEN_IMAGE_API_KEY="your-qwen-api-key"
QWEN_IMAGE_BASE_URL="https://api.your-qwen-provider.com"

# Video Generation Providers
WAN_API_KEY="your-wan-api-key"
WAN_BASE_URL="https://api.your-wan-provider.com"

LTX_API_KEY="your-ltx-api-key"
LTX_BASE_URL="https://api.your-ltx-provider.com"

HUNYUAN_API_KEY="your-hunyuan-api-key"
HUNYUAN_BASE_URL="https://api.your-hunyuan-provider.com"

# Credit Costs (adjust as needed)
CREDIT_COST_IMAGE_GENERATION=1
CREDIT_COST_IMAGE_EDITING=2
CREDIT_COST_VIDEO_PREVIEW=5
CREDIT_COST_STANDARD_VIDEO=10
CREDIT_COST_PREMIUM_VIDEO=20
CREDIT_COST_UPSCALING=3

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60

# Feature Flags
ENABLE_MOCK_PROVIDER=true
ENABLE_REAL_PROVIDERS=false